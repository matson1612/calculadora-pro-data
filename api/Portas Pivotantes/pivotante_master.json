        {"nome":"HTUBO","formula":"(\"{VARIAÇÃO_TUBOS}\" == \"APENAS VERTICAL\" && \"{BANDEIRA_SUP}\" == \"SIM\") ? 70 : (\"{VARIAÇÃO_TUBOS}\" == \"VERTICAL COMPLETO + HORIZONTAL\" && \"{BANDEIRA_SUP}\" == \"SIM\") ? 70 : (\"{VARIAÇÃO_TUBOS}\" == \"VERTICAL COMPLETO + HORIZONTAL COMPLETO\" && \"{BANDEIRA_SUP}\" == \"SIM\") ? 70 : 0"},
