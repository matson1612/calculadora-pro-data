        {"nome":"BAND_SUP_DIV","formula":"(\"{VARIAÇÃO_TUBOS}\" != \"APENAS VERTICAL\" && \"{BANDEIRA_SUP}\" == \"SIM\" && \"{TUBOS}\" == \"SIM\" && \"{VARIAÇÃO_TUBOS}\" != \"VERTICAL COMPLETO + HORIZONTAL COMPLETO\" && \"{VARIAÇÃO_TUBOS}\" != \"VERTICAL COMPLETO + HORIZONTAL\") ? ({L}-{LF_FIXO_E}*{DIVISAO_BANDEIRA_E}-{LF_FIXO_D}*{DIVISAO_BANDEIRA_D}-{DESCONTO_PADRAO_FIXOS})/{DIVISAO_BANDEIRA_SUP} : ({LV_PORTA}-{DESCONTO_PADRAO_FIXOS})/{DIVISAO_BANDEIRA_SUP}"},
        {"nome":"HFIXO_1","formula":"(\"{VARIAÇÃO_TUBOS}\" == \"APENAS HORIZONTAL\" || \"{VARIAÇÃO_TUBOS}\" == \"HORIZONTAL COMPLETO + VERTICAL\" || \"{VARIAÇÃO_TUBOS}\" == \"VERTICAL COMPLETO + HORIZONTAL COMPLETO\") ? {HV_PORTA}-{DESCONTO_PADRAO_FIXOS} : {H}-{DESCONTO_PADRAO_FIXOS}"},
