{
    "id": "light_holder_comum",
    "nome": "Light Holder Comum (Mão Amiga)",
    "folhas": 0,
    "espessura": "8mm",
    "refKit": null,
    "opcoes": {
        "folhas": ["2", "3", "4", "5", "6", "7", "8", "9", "10"],
        "abertura_dupla": ["não", "sim"],
        "puxador": ["não", "simples", "puxador h"],
        "distancia_puxador": ["50", "80", "100", "150"],
        "entre_furos": ["300", "400", "500", "600", "800", "1000", "1200"]
    },
    "condicoes_opcoes": {
        "entre_furos": "\"{PUXADOR}\" == \"PUXADOR H\"",
        "distancia_puxador": "\"{PUXADOR}\" != \"NÃO\" && \"{PUXADOR}\" != \"SEM PUXADOR\""
    },
    "regras_padrao": {},
    "regras_ferragens": {},
    "componentes_composicao": [],
    "variaveis_calculo": [
        { "nome": "NF", "formula": "{FOLHAS}" },
        { "nome": "NPUX", "formula": "\"{ABERTURA_DUPLA}\" == \"SIM\" ? 2 : 1" },
        { "nome": "DPUX", "formula": "\"{PUXADOR}\" == \"NÃO\" || \"{PUXADOR}\" == \"SEM PUXADOR\" ? 52 : {DISTANCIA_PUXADOR}" },
        { "nome": "H_VIDRO", "formula": "{H} - 65" },
        
        { "nome": "L_FIXO", "formula": "({L} + 15 * ({NF} - 1) - {DPUX} * {NPUX}) / {NF}" },
        { "nome": "L_MOVEL", "formula": "{L_FIXO} + {DPUX}" },
        { "nome": "HFURO", "formula": "1050 - ({ENTRE_FUROS} / 2)" },
        
        { "nome": "QTD_FIXO_CALC", "formula": "{NF} - {NPUX}" },
        { "nome": "QTD_PORTA_CALC", "formula": "{NPUX}" },
        
        { "nome": "CANVAS_W", "formula": "800" },
        { "nome": "PANEL_W", "formula": "{CANVAS_W} / {NF}" }
    ],
    "vidros": [
        { "tipo": "Porta", "isMovel": true, "w": "{L_MOVEL}", "h": "{H_VIDRO}", "qtd": "{QTD_PORTA_CALC}" },
        { "tipo": "Fixo", "isMovel": false, "w": "{L_FIXO}", "h": "{H_VIDRO}", "qtd": "{QTD_FIXO_CALC}", "condicao": "{QTD_FIXO_CALC} > 0" }
    ],
    "perfis": [],
    "projeto_template": {
        "versao": "3.0",
        "canvas": {"w": 1600, "h": 1200},
        "elementos": [
            {"tipo": "bounding-box", "x": 100, "y": 100, "w": 800, "h": 500, "zIndex": 0, "texto": "ÁREA DE CORTE"},
            {"tipo": "dim-h", "x": 100, "y": 550, "w": 800, "h": 10, "zIndex": 10, "texto": "Vão Total: {L}"},
            {"tipo": "dim-v", "x": 80, "y": 150, "w": 10, "h": 350, "zIndex": 10, "texto": "Vão Total: {H}"},
            
            {"tipo": "panel-movel", "x": "100", "y": 150, "w": "{PANEL_W}", "h": 350, "zIndex": 10, "condicao": "{NF} >= 1"},
            {"tipo": "text", "x": "100", "y": 320, "w": "{PANEL_W}", "h": 15, "zIndex": 10, "texto": "Porta", "color": "#fde047", "condicao": "{NF} >= 1"},
            {"tipo": "text", "x": "100", "y": 335, "w": "{PANEL_W}", "h": 15, "zIndex": 10, "texto": "{QTD_PORTA} {TAG_PORTA}", "color": "#fde047", "condicao": "{NF} >= 1"},
            {"tipo": "text", "x": "100", "y": 355, "w": "{PANEL_W}", "h": 15, "zIndex": 10, "texto": "{L_MOVEL}", "color": "#f8fafc", "condicao": "{NF} >= 1"},
            
