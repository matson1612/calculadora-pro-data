{
    "id": "light_holder_comum",
    "nome": "Light Holder Comum (Mão Amiga)",
    "folhas": 0,
    "espessura": "8mm",
    "refKit": null,
    "opcoes": {
        "folhas": ["2", "3", "4", "5", "6", "7", "8", "9", "10"],
        "abertura_dupla": ["não", "sim"],
        "fechadura": ["3530", "não"],
        "puxador": ["não", "simples", "puxador h"],
        "distancia_puxador": ["50", "80", "100", "150"],
        "entre_furos": ["300", "400", "500", "600", "800", "1000", "1200"]
    },
    "condicoes_opcoes": {
        "entre_furos": "\"{PUXADOR}\" == \"PUXADOR H\"",
        "distancia_puxador": "\"{PUXADOR}\" != \"NÃO\" && \"{PUXADOR}\" != \"SEM PUXADOR\""
    },
    "regras_padrao": {},
    "regras_ferragens": {},
    "componentes_composicao": [],
    "variaveis_calculo": [
        { "nome": "NF", "formula": "{FOLHAS}" },
        { "nome": "NPUX", "formula": "\"{ABERTURA_DUPLA}\" == \"SIM\" ? 2 : 1" },
        { "nome": "DPUX", "formula": "\"{PUXADOR}\" == \"NÃO\" || \"{PUXADOR}\" == \"SEM PUXADOR\" ? 52 : {DISTANCIA_PUXADOR}+20" },
        { "nome": "H_VIDRO", "formula": "{H} - 60" },
        { "nome": "L_FIXO", "formula": "({L} + 15 * ({NF} - 1) - {DPUX} * {NPUX}) / {NF}" },
        { "nome": "L_MOVEL", "formula": "{L_FIXO} + {DPUX}" },
        { "nome": "HFURO", "formula": "1050 - ({ENTRE_FUROS} / 2)" },
        { "nome": "QTD_FIXO_CALC", "formula": "{NF} - {NPUX}" },
        { "nome": "QTD_PORTA_CALC", "formula": "{NPUX}" },
        { "nome": "QTD_TRILHO", "formula": "\"{ABERTURA_DUPLA}\" == \"SIM\" ? {NF} : {NF} - 1" },
        { "nome": "QTD_FECH", "formula": "\"{ABERTURA_DUPLA}\" == \"SIM\" ? 2 : 1" },
        { "nome": "PANEL_W", "formula": "80" },
        { "nome": "CANVAS_W", "formula": "{NF} * {PANEL_W}" }
    ],
    "ferragens_dinamicas": [
        { "cod": "roldana_1126e", "qtd": "{QTD_TRILHO} * 2" },
        { "cod": "batente", "qtd": "{NF} * 2" },
        { "cod": "3530", "qtd": "{QTD_FECH}", "condicao": "\"{FECHADURA}\" == \"3530\"" },
        { "cod": "3230", "qtd": "{QTD_FECH}", "condicao": "\"{FECHADURA}\" == \"3530\"" },
        { "cod": "puxador_simples", "qtd": "{QTD_FECH}", "condicao": "\"{PUXADOR}\" == \"SIMPLES\"" },
        { "cod": "puxador_h", "qtd": "{QTD_FECH}", "condicao": "\"{PUXADOR}\" == \"PUXADOR H\"" }
    ],
    "vidros": [
        { "tipo": "Porta", "isMovel": true, "w": "{L_MOVEL}", "h": "{H_VIDRO}", "qtd": "{QTD_PORTA_CALC}" },
        { "tipo": "Fixo", "isMovel": false, "w": "{L_FIXO}", "h": "{H_VIDRO}", "qtd": "{QTD_FIXO_CALC}", "condicao": "{QTD_FIXO_CALC} > 0" }
    ],
    "perfis": [
        { "cod": "leito", "tam": "{L_MOVEL}", "qtd": "{QTD_PORTA_CALC}", "meta": "Leito Inferior/Sup (Porta)" },
        { "cod": "leito", "tam": "{L_FIXO}", "qtd": "{QTD_FIXO_CALC}", "meta": "Leito Inferior/Sup (Fixo)", "condicao": "{QTD_FIXO_CALC} > 0" },
        { "cod": "mao_amiga", "tam": "{H_VIDRO}", "qtd": "({NF} - 1) * 2", "meta": "Transpasse Mão de Amiga" },
        { "cod": "filete", "tam": "{L}", "qtd": "{QTD_TRILHO}", "meta": "Trilho Filete Superior" },
        { "cod": "guia_stanller", "tam": "{L}", "qtd": "{QTD_TRILHO}", "meta": "Guia Stanller (Largura Superior)" },
        { "cod": "guia_stanller", "tam": "{H}", "qtd": 2, "meta": "Guia Stanller (Laterais)" },
        { "cod": "escovinha_5x7", "tam": "{L_MOVEL}", "qtd": "{QTD_PORTA_CALC} * 2", "meta": "Escova 5x7 (Leito Porta)" },
        { "cod": "escovinha_5x7", "tam": "{L_FIXO}", "qtd": "{QTD_FIXO_CALC} * 2", "meta": "Escova 5x7 (Leito Fixo)", "condicao": "{QTD_FIXO_CALC} > 0" },
        { "cod": "escovinha_5x7", "tam": "{H_VIDRO}", "qtd": 4, "meta": "Escova 5x7 (Guias Laterais)" },
        { "cod": "escovinha_7x6", "tam": "{H_VIDRO}", "qtd": "({NF} - 1) * 4", "meta": "Escova 7x6 (Mão de Amiga)" }
    ],
