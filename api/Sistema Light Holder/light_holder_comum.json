            "formula": "{NF} - {NPUX}"
        },
        {
            "nome": "QTD_PORTA_CALC",
            "formula": "{NPUX}"
        },
        {
            "nome": "CANVAS_W",
            "formula": "800"
        },
        {
            "nome": "PANEL_W",
            "formula": "{CANVAS_W} / {NF}"
        }
