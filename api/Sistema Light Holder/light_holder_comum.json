            "3530",
            "não"
        ],
        "puxador": [
            "não",
            "simples",
            "puxador h"
        ],
        "distancia_puxador": [
            "50",
            "80",
            "100",
            "150"
        ],
        "entre_furos": [
            "300",
            "400",
            "500",
            "600",
            "800",
            "1000",
            "1200"
        ]
    },
    "condicoes_opcoes": {
        "entre_furos": "\"{PUXADOR}\" == \"PUXADOR H\"",
        "distancia_puxador": "\"{PUXADOR}\" != \"NÃO\" && \"{PUXADOR}\" != \"SEM PUXADOR\""
    },
    "regras_padrao": {},
    "regras_ferragens": {},
    "componentes_composicao": [],
    "variaveis_calculo": [
        {
            "nome": "NF",
            "formula": "{FOLHAS}"
        },
        {
            "nome": "NPUX",
            "formula": "\"{ABERTURA_DUPLA}\" == \"SIM\" ? 2 : 1"
        },
        {
            "nome": "DPUX",
            "formula": "\"{PUXADOR}\" == \"NÃO\" || \"{PUXADOR}\" == \"SEM PUXADOR\" ? 52 : {DISTANCIA_PUXADOR}"
        },
        {
            "nome": "H_VIDRO",
            "formula": "{H} - 65"
        },
        {
            "nome": "L_FIXO",
            "formula": "({L} + 15 * ({NF} - 1) - {DPUX} * {NPUX}) / {NF}"
        },
        {
            "nome": "L_MOVEL",
            "formula": "{L_FIXO} + {DPUX}"
        },
        {
            "nome": "HFURO",
            "formula": "1050 - ({ENTRE_FUROS} / 2)"
        },
        {
            "nome": "QTD_FIXO_CALC",
            "formula": "{NF} - {NPUX}"
        },
        {
            "nome": "QTD_PORTA_CALC",
            "formula": "{NPUX}"
        },
        {
            "nome": "CANVAS_W",
            "formula": "800"
        },
        {
            "nome": "PANEL_W",
            "formula": "{CANVAS_W} / {NF}"
        }
    ],
    "vidros": [
        {
            "tipo": "Porta",
            "isMovel": true,
            "w": "{L_MOVEL}",
            "h": "{H_VIDRO}",
            "qtd": "{QTD_PORTA_CALC}"
        },
        {
            "tipo": "Fixo",
            "isMovel": false,
            "w": "{L_FIXO}",
            "h": "{H_VIDRO}",
            "qtd": "{QTD_FIXO_CALC}",
            "condicao": "{QTD_FIXO_CALC} > 0"
        }
    ],
